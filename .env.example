DB_URL=jdbc:postgresql://localhost:5432/tapetes_kalke
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
# Obrigatório. Gere com: openssl rand -base64 64  (ou, no PowerShell 7: [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(64)))
JWT_SECRET=replace-with-a-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION_SECONDS=3600
# true liga o Swagger em /swagger-ui/index.html (somente desenvolvimento)
API_DOCS_ENABLED=false
FRONTEND_URL=http://localhost:5173
BOOTSTRAP_ADMIN_EMAIL=admin@tapeteskalke.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_FIRST_START
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=